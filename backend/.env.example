# AeroShield AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=production

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=15

# Gemini AI (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Air Quality APIs (Optional - system automatically uses Open-Meteo & OpenAQ free tiers with physics fallback)
WAQI_API_TOKEN=
OPENAQ_API_KEY=
